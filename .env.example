# Copier en .env.local puis remplir.

# Origine de l'app, sans slash final.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# E-mails autorisés dans /admin, séparés par des virgules.
ADMIN_EMAILS=
# Expéditeur des e-mails (domaine vérifié dans Resend).
SUPPORT_EMAIL=

# Supabase : en local, `npm run db:start` affiche l'URL et les clés.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service role), serveur uniquement : galeries invitées et back-office.
SUPABASE_SECRET_KEY=

# Stripe : abonnements des photographes, paiements des clients, commandes d'albums.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend : e-mails. Sans clé, rien n'est envoyé (journalisé seulement).
RESEND_API_KEY=
